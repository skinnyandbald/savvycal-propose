{
  "name": "propose-times",
  "title": "Propose Times",
  "description": "Generate meeting time proposals from your SavvyCal or Cal.com availability",
  "icon": "extension-icon.png",
  "author": "skinnyandbald",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "propose-times",
      "title": "Propose Times",
      "description": "Generate a message with your available meeting times",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "provider",
      "type": "dropdown",
      "required": true,
      "title": "Calendar Provider",
      "description": "Which scheduling service to use",
      "default": "savvycal",
      "data": [
        {
          "title": "SavvyCal",
          "value": "savvycal"
        },
        {
          "title": "Cal.com",
          "value": "calcom"
        }
      ]
    },
    {
      "name": "savvycalToken",
      "type": "password",
      "required": false,
      "title": "SavvyCal API Token",
      "description": "Your SavvyCal Personal Access Token (starts with pt_secret_). Required if using SavvyCal.",
      "placeholder": "pt_secret_..."
    },
    {
      "name": "savvycalLink",
      "type": "textfield",
      "required": false,
      "title": "SavvyCal Link Slug(s)",
      "description": "Comma-separated slugs from your SavvyCal URLs (e.g., 'chat' or 'chat, interview'). First slug is the default. Required if using SavvyCal.",
      "default": "chat"
    },
    {
      "name": "savvycalUsername",
      "type": "textfield",
      "required": false,
      "title": "SavvyCal Username",
      "description": "Your SavvyCal username (e.g., 'skinnyandbald'). Required if using SavvyCal."
    },
    {
      "name": "calcomUsername",
      "type": "textfield",
      "required": false,
      "title": "Cal.com Username",
      "description": "Your Cal.com username (e.g., 'skinnyandbald' from cal.com/skinnyandbald/...). Required if using Cal.com."
